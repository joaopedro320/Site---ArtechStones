 "outputDirectory": "dist",
 "cleanUrls": true,
 "trailingSlash": true,
 "redirects": [
  {
   "source": "/artechlaminas",
   "destination": "/pedras/artechlaminas/",
   "permanent": true
  },
  {
   "source": "/artechlaminas/",
   "destination": "/pedras/artechlaminas/",
   "permanent": true
  },
  {
   "source": "/artechquartzo",
   "destination": "/pedras/artechquartzo/",
   "permanent": true
  },
  {
   "source": "/artechquartzo/",
   "destination": "/pedras/artechquartzo/",
   "permanent": true
  },
  {
   "source": "/artechnano",
   "destination": "/pedras/artechnano/",
   "permanent": true
  },
  {
   "source": "/artechnano/",
   "destination": "/pedras/artechnano/",
   "permanent": true
  },
  {
   "source": "/artechprime",
   "destination": "/pedras/",
   "permanent": true
  },
  {
   "source": "/artechprime/",
   "destination": "/pedras/",
   "permanent": true
  },
  {
   "source": "/granito",
   "destination": "/pedras/pedras-naturais/",
   "permanent": true
  },
  {
