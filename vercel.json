   "destination": "/pedras/pedras-naturais/",
   "permanent": true
  },
  {
   "source": "/distribuidora-de-pedras-importadas",
   "destination": "/sobre/",
   "permanent": true
  },
  {
   "source": "/distribuidora-de-pedras-importadas/",
   "destination": "/sobre/",
   "permanent": true
  },
  {
   "source": "/guia-de-pedras-importadas",
   "destination": "/perguntas-frequentes/",
   "permanent": true
  },
  {
   "source": "/guia-de-pedras-importadas/",
   "destination": "/perguntas-frequentes/",
   "permanent": true
  },
  {
   "source": "/faq-perguntas-frequentes",
   "destination": "/perguntas-frequentes/",
   "permanent": true
  },
  {
   "source": "/faq-perguntas-frequentes/",
   "destination": "/perguntas-frequentes/",
   "permanent": true
  },
  {
   "source": "/linha-estrelar",
   "destination": "/pedras/artechquartzo/",
   "permanent": true
  },
  {
   "source": "/linha-estrelar/",
   "destination": "/pedras/artechquartzo/",
   "permanent": true
  },
  {
   "source": "/linha-liso",
   "destination": "/pedras/artechquartzo/",
   "permanent": true
  },
  {
   "source": "/linha-liso/",
   "destination": "/pedras/artechquartzo/",
   "permanent": true
  },
  {
   "source": "/linha-com-veios",
   "destination": "/pedras/artechquartzo/",
   "permanent": true
  },
  {
   "source": "/linha-com-veios/",
   "destination": "/pedras/artechquartzo/",
   "permanent": true
  },
  {
   "source": "/linha-prime",
   "destination": "/pedras/",
   "permanent": true
  },
  {
   "source": "/linha-prime/",
   "destination": "/pedras/",
